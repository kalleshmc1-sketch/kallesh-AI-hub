# GEMINI_API_KEY / GOOGLE_AI_API_KEY / AI_API_KEY / OPENAI_API_KEY:
# Configure your keys securely via the Secrets panel in the AI Studio UI. Never expose private keys in frontend code.
GEMINI_API_KEY=MY_GEMINI_API_KEY
GOOGLE_AI_API_KEY=MY_GOOGLE_AI_API_KEY
AI_API_KEY=MY_AI_API_KEY
OPENAI_API_KEY=MY_OPENAI_API_KEY

# Dedicated Image & Video Generation Provider Configuration (Configure via AI Studio Secrets panel):
IMAGE_GENERATION_API_KEY=MY_IMAGE_GENERATION_API_KEY
IMAGE_GENERATION_MODEL=gemini-2.5-flash-image
VIDEO_GENERATION_API_KEY=MY_VIDEO_GENERATION_API_KEY
VIDEO_GENERATION_MODEL=veo-3.1-fast-generate-preview

# Production Database & Authentication Secrets:
DATABASE_URL=postgresql://postgres:password@db.kalleshaihub.com:5432/kallesh_ai_hub?schema=public
AUTH_SECRET=MY_PRODUCTION_AUTH_JWT_SECRET

# Razorpay Payment Gateway Credentials (Configure via AI Studio Secrets panel; never hardcode in frontend):
RAZORPAY_KEY_ID=rzp_test_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_BACKEND_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Production Domain & Backend API Configuration (No hardcoded localhost URLs):
PRODUCTION_URL=https://kalleshaihub.com
BACKEND_API_URL=https://kalleshaihub.com/api

# Authentication, Database & AI Provider Defaults:
AUTH_PROVIDER=firebase_auth_and_jwt_session
DATABASE_PROVIDER=postgresql_prisma_and_room_sql
AI_DEFAULT_MODEL=gemini-3-flash-preview
TTS_VOICE_ID=Puck
